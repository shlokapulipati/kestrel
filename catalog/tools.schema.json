{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Kestrel tool catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "dataStatus", "updatedAt", "categories", "tools"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "dataStatus": { "enum": ["sample", "reviewed"] },
    "dataNote": { "type": "string", "maxLength": 400 },
    "updatedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/category" }
    },
    "tools": {
      "type": "array",
      "items": { "$ref": "#/definitions/tool" }
    }
  },
  "definitions": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,39}$"
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 60 }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "category", "description", "detection", "platforms"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 60 },
        "category": { "$ref": "#/definitions/id" },
        "description": { "type": "string", "minLength": 1, "maxLength": 400 },
        "homepage": { "type": "string", "pattern": "^https://" },
        "notes": {
          "type": "array",
          "items": { "type": "string", "maxLength": 400 }
        },
        "warnings": {
          "type": "array",
          "items": { "$ref": "#/definitions/warning" }
        },
        "detection": { "$ref": "#/definitions/detection" },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/platform" }
        }
      }
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "text"],
      "properties": {
        "level": { "enum": ["info", "caution"] },
        "text": { "type": "string", "minLength": 1, "maxLength": 400 }
      }
    },
    "detection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executables", "versionArgs", "versionPattern"],
      "properties": {
        "executables": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" }
        },
        "versionArgs": {
          "type": "array",
          "maxItems": 2,
          "items": { "type": "string", "pattern": "^-{1,2}[A-Za-z0-9-]+$" }
        },
        "versionPattern": { "type": "string", "minLength": 1, "maxLength": 120 }
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "status", "installMethods"],
      "properties": {
        "os": { "enum": ["linux", "windows", "macos"] },
        "distroFamily": { "enum": ["fedora", "debian", "arch", "suse"] },
        "arch": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["x86_64", "aarch64"] }
        },
        "status": { "enum": ["supported", "planned", "untested", "unsupported"] },
        "note": { "type": "string", "maxLength": 400 },
        "installMethods": {
          "type": "array",
          "items": { "$ref": "#/definitions/installMethod" }
        }
      }
    },
    "installMethod": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "requiresElevation"],
      "properties": {
        "method": { "enum": ["system-package", "version-manager", "official-archive"] },
        "packageManager": { "enum": ["dnf", "apt", "brew", "winget"] },
        "packageName": { "type": "string", "pattern": "^[a-z0-9][a-z0-9+._-]*$" },
        "requiresElevation": { "type": "boolean" }
      }
    }
  }
}